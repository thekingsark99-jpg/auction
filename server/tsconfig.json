{
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "noImplicitAny": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "removeComments": true,
    "declaration": false,
    "jsx": "preserve",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "outDir": "dist",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.css"
  ],
  "typeAcquisition": {
    "enable": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "__tests__"
  ]
}
